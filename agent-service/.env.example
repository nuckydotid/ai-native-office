# Copy to .env for local runs. Nothing here is a secret; never put keys or tokens in this file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# Models (verified for this project in the `global` location; they are configuration, not code).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
GEMINI_MODEL_FALLBACK=gemini-3.5-flash
EMBED_MODEL=gemini-embedding-001

# Backends: vertex|fake and firestore|memory. The fake pair runs with no Google Cloud at all.
MODEL_BACKEND=fake
KNOWLEDGE_BACKEND=memory
AUTH_MODE=none
ALLOWED_CALLER=
MAX_OUTPUT_TOKENS=8192
