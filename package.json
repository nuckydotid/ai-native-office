{
  "name": "worktrees-studio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "check:ui": "node scripts/check-ui.mjs",
    "check": "tsc --noEmit && node scripts/check-ui.mjs && node scripts/sync-core.mjs --check && npm test --silent",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\"",
    "sync-core": "node scripts/sync-core.mjs"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@heroui/react": "^2.8.10",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.54.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
